@model TipoInmueble

@{
    ViewData["Title"] = "Detalle del tipo de inmueble";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Detalle del tipo de inmueble</h1>
                <p class="text-secondary mb-0">Información completa de la clasificación.</p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.IdTipoInmueble" class="btn btn-primary">Editar</a>
        </div>

        <div class="card app-card">
            <div class="card-body p-4">
                <dl class="row mb-0 app-details">
                    <dt class="col-sm-4">Identificador</dt>
                    <dd class="col-sm-8">@Model.IdTipoInmueble</dd>
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                </dl>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-link px-0">Volver al listado</a>
        </div>
    </div>
</div>
