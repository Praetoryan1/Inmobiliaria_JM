@model IEnumerable<TipoInmueble>

@{
    ViewData["Title"] = "Tipos de inmueble";
    var busqueda = ViewBag.Busqueda as string ?? string.Empty;
    var paginaActual = Convert.ToInt32(ViewBag.PaginaActual);
    var totalPaginas = Convert.ToInt32(ViewBag.TotalPaginas);
    var cantidadTotal = Convert.ToInt32(ViewBag.CantidadTotal);
}

<partial name="_Mensajes" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Tipos de inmueble</h1>
        <p class="text-secondary mb-0">Clasificación disponible para los inmuebles.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo</a>
</div>

<div class="card app-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <label for="busqueda" class="visually-hidden">Buscar tipos de inmueble</label>
                <input id="busqueda" name="busqueda" value="@busqueda" class="form-control"
                       placeholder="Buscar por nombre" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(busqueda))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center text-secondary py-5">
                            No se encontraron tipos de inmueble.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tipo in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@tipo.Nombre</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@tipo.IdTipoInmueble"
                                   class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a asp-action="Edit" asp-route-id="@tipo.IdTipoInmueble"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@tipo.IdTipoInmueble"
                                   class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <span class="text-secondary small">@cantidadTotal tipo(s) encontrado(s)</span>
        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de tipos de inmueble">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                           asp-route-busqueda="@busqueda">Anterior</a>
                    </li>
                    @for (var pagina = 1; pagina <= totalPaginas; pagina++)
                    {
                        <li class="page-item @(pagina == paginaActual ? "active" : null)">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@pagina"
                               asp-route-busqueda="@busqueda">@pagina</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                           asp-route-busqueda="@busqueda">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
