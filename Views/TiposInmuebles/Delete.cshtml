@model TipoInmueble

@{
    ViewData["Title"] = "Eliminar tipo de inmueble";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card app-card border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Eliminar tipo de inmueble</h1>
                <p>Esta acción eliminará definitivamente la siguiente clasificación:</p>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="fw-semibold">@Model.Nombre</div>
                    <div class="text-secondary">Identificador @Model.IdTipoInmueble</div>
                </div>

                <p class="fw-semibold">¿Desea continuar?</p>
                <form asp-action="Delete" asp-route-id="@Model.IdTipoInmueble" method="post">
                    <input asp-for="IdTipoInmueble" type="hidden" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
