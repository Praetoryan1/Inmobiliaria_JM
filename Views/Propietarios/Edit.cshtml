@model Propietario

@{
    ViewData["Title"] = "Editar propietario";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="mb-4">
            <h1 class="h2 mb-1">Editar propietario</h1>
            <p class="text-secondary mb-0">Actualice los datos del propietario seleccionado.</p>
        </div>

        <div class="card app-card">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.IdPropietario" method="post">
                    <input asp-for="IdPropietario" type="hidden" />
                    <partial name="_Formulario" model="Model" />
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
