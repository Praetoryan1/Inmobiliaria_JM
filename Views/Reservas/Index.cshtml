@model IEnumerable<Reserva>

@{
    ViewData["Title"] = "Reservas";
    var busqueda = ViewBag.Busqueda as string ?? string.Empty;
    var estado = ViewBag.Estado as string ?? string.Empty;
    var paginaActual = Convert.ToInt32(ViewBag.PaginaActual);
    var totalPaginas = Convert.ToInt32(ViewBag.TotalPaginas);
    var cantidadTotal = Convert.ToInt32(ViewBag.CantidadTotal);
}

<partial name="_Mensajes" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Reservas</h1>
        <p class="text-secondary mb-0">Alquileres temporarios registrados.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nueva reserva</a>
</div>

<div class="card app-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-lg">
                <label for="busqueda" class="visually-hidden">Buscar reservas</label>
                <input id="busqueda" name="busqueda" value="@busqueda" class="form-control"
                       placeholder="Buscar por inmueble, tipo, inquilino o DNI" />
            </div>
            <div class="col-12 col-sm-5 col-lg-3">
                <label for="estado" class="visually-hidden">Filtrar por estado</label>
                <select id="estado" name="estado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="pendiente" selected="@(estado == "pendiente")">Pendientes</option>
                    <option value="vigente" selected="@(estado == "vigente")">Vigentes</option>
                    <option value="finalizada" selected="@(estado == "finalizada")">Finalizadas</option>
                    <option value="anticipada" selected="@(estado == "anticipada")">Terminadas anticipadamente</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(busqueda) || !string.IsNullOrWhiteSpace(estado))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Inmueble</th>
                    <th>Inquilino</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Monto por día</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            No se encontraron reservas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var reserva in Model)
                    {
                        var claseEstado = reserva.Estado.StartsWith("Vigente")
                            ? "text-bg-success"
                            : reserva.Estado == "Pendiente"
                                ? "text-bg-primary"
                                : "text-bg-secondary";
                        <tr>
                            <td class="fw-semibold">@reserva.Inmueble?.Direccion</td>
                            <td>@reserva.Inquilino?.Apellido, @reserva.Inquilino?.Nombre</td>
                            <td>@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                            <td>@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                            <td>@reserva.MontoDia.ToString("C")</td>
                            <td><span class="badge @claseEstado">@reserva.Estado</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@reserva.IdReserva"
                                   class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a asp-action="Edit" asp-route-id="@reserva.IdReserva"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@reserva.IdReserva"
                                   class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <span class="text-secondary small">@cantidadTotal reserva(s) encontrada(s)</span>
        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de reservas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                           asp-route-busqueda="@busqueda" asp-route-estado="@estado">Anterior</a>
                    </li>
                    @for (var pagina = 1; pagina <= totalPaginas; pagina++)
                    {
                        <li class="page-item @(pagina == paginaActual ? "active" : null)">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@pagina"
                               asp-route-busqueda="@busqueda" asp-route-estado="@estado">@pagina</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                           asp-route-busqueda="@busqueda" asp-route-estado="@estado">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
