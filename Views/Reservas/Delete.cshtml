@model Reserva

@{
    ViewData["Title"] = "Eliminar reserva";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card app-card border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Eliminar reserva</h1>
                <p>Esta acción eliminará definitivamente la siguiente reserva:</p>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="fw-semibold">@Model.Inmueble?.Direccion</div>
                    <div class="text-secondary">
                        @Model.Inquilino?.Apellido, @Model.Inquilino?.Nombre ·
                        @Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <p class="fw-semibold">¿Desea continuar?</p>
                <form asp-action="Delete" asp-route-id="@Model.IdReserva" method="post">
                    <input asp-for="IdReserva" type="hidden" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
