@model PagoEditarViewModel

@{
    ViewData["Title"] = "Editar concepto del pago";
    var pago = ViewBag.Pago as Pago;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="h2 mb-1">Editar concepto del pago</h1>
            <p class="text-secondary mb-0">La fecha y el importe se conservan como información histórica.</p>
        </div>

        <div class="card app-card">
            <div class="card-body p-4">
                @if (pago is not null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="text-secondary small">Fecha de pago</div>
                            <div class="fw-semibold">@pago.FechaPago.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-secondary small">Importe</div>
                            <div class="fw-semibold">@pago.Importe.ToString("C")</div>
                        </div>
                    </div>
                }

                <form asp-action="Edit" asp-route-id="@Model.IdPago" method="post">
                    <input asp-for="IdPago" type="hidden" />
                    <input asp-for="IdReserva" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div>
                        <label asp-for="Concepto" class="form-label"></label>
                        <input asp-for="Concepto" class="form-control" />
                        <span asp-validation-for="Concepto" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" asp-route-idReserva="@Model.IdReserva"
                           class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar concepto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
