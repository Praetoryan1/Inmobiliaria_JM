@model PagoCrearViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input asp-for="IdReserva" type="hidden" />

<div class="row g-3">
    <div class="col-lg-5">
        <label asp-for="Concepto" class="form-label"></label>
        <input asp-for="Concepto" class="form-control"
               placeholder="Por ejemplo: seña inicial" />
        <span asp-validation-for="Concepto" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 col-lg-3">
        <label asp-for="FechaPago" class="form-label"></label>
        <input asp-for="FechaPago" class="form-control" type="date" />
        <span asp-validation-for="FechaPago" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 col-lg-4">
        <label asp-for="Importe" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Importe" class="form-control" type="number"
                   min="0.01" step="0.01" />
        </div>
        <span asp-validation-for="Importe" class="text-danger small"></span>
    </div>
</div>
