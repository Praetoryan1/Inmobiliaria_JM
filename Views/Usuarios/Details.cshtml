@model Usuario

@{
    ViewData["Title"] = "Detalle del usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Detalle del usuario</h1>
                <p class="text-secondary mb-0">Información de la cuenta y sus permisos.</p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-primary">Editar</a>
        </div>

        <div class="card app-card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="Avatar de @Model.NombreCompleto"
                             class="app-avatar-preview" />
                    }
                    else
                    {
                        <div class="app-avatar-preview app-avatar-placeholder" aria-hidden="true">
                            @Model.Nombre[..1].ToUpperInvariant()@Model.Apellido[..1].ToUpperInvariant()
                        </div>
                    }
                    <div>
                        <h2 class="h4 mb-1">@Model.NombreCompleto</h2>
                        <span class="badge @(Model.Rol == RolesUsuario.Administrador ? "text-bg-primary" : "text-bg-secondary")">
                            @Model.Rol
                        </span>
                    </div>
                </div>
                <dl class="row mb-0 app-details">
                    <dt class="col-sm-4">Identificador</dt>
                    <dd class="col-sm-8">@Model.IdUsuario</dd>
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Apellido</dt>
                    <dd class="col-sm-8">@Model.Apellido</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">@Model.Rol</dd>
                </dl>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-link px-0">Volver al listado</a>
        </div>
    </div>
</div>
