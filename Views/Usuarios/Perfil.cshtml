@model PerfilUsuarioViewModel

@{
    ViewData["Title"] = "Mi perfil";
    var rol = ViewBag.Rol as string ?? string.Empty;
}

<partial name="_Mensajes" />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Mi perfil</h1>
        <p class="text-secondary mb-0">Actualice sus datos personales, contraseña y avatar.</p>
    </div>
    <span class="badge text-bg-secondary align-self-start align-self-md-center">@rol</span>
</div>

<form asp-action="Perfil" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card app-card h-100">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarActual))
                    {
                        <img src="@Model.AvatarActual" alt="Avatar actual"
                             class="app-avatar-preview mb-3" />
                    }
                    else
                    {
                        <div class="app-avatar-preview app-avatar-placeholder mx-auto mb-3">
                            @(string.IsNullOrWhiteSpace(Model.Nombre) ? "U" : Model.Nombre[..1].ToUpperInvariant())
                        </div>
                    }

                    <label asp-for="AvatarArchivo" class="form-label"></label>
                    <input asp-for="AvatarArchivo" class="form-control"
                           accept="image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="AvatarArchivo" class="text-danger"></span>
                    <p class="small text-secondary mt-2 mb-0">JPG, PNG o WEBP. Máximo 5 MB.</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card app-card mb-4">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 mb-0">Datos personales</h2>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-control" />
                            <span asp-validation-for="Apellido" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card app-card">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 mb-0">Cambiar contraseña</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small">
                        Deje estos campos vacíos si no desea cambiar la contraseña.
                    </p>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="PasswordActual" class="form-label"></label>
                            <input asp-for="PasswordActual" class="form-control"
                                   autocomplete="current-password" />
                            <span asp-validation-for="PasswordActual" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PasswordNueva" class="form-label"></label>
                            <input asp-for="PasswordNueva" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="PasswordNueva" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmarPasswordNueva" class="form-label"></label>
                            <input asp-for="ConfirmarPasswordNueva" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarPasswordNueva" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
