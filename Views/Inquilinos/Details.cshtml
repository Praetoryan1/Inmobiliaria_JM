@model Inquilino

@{
    ViewData["Title"] = "Detalle del inquilino";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Detalle del inquilino</h1>
                <p class="text-secondary mb-0">Información completa del registro.</p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.IdInquilino" class="btn btn-primary">Editar</a>
        </div>

        <div class="card app-card">
            <div class="card-body p-4">
                <h2 class="h4 mb-4">@Model.Apellido, @Model.Nombre</h2>
                <dl class="row mb-0 app-details">
                    <dt class="col-sm-4">DNI</dt>
                    <dd class="col-sm-8">@Model.Dni</dd>
                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@(Model.Telefono ?? "No informado")</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                </dl>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-link px-0">Volver al listado</a>
        </div>
    </div>
</div>
